# Copy to /opt/mobile/server/.env and fill in CTM_SECRET.
# Generate one with:  openssl rand -base64 48

CTM_SECRET=replace-me
CTM_PUBLIC_URL=https://ctm.ubermensch.cc
CTM_HOST=127.0.0.1
CTM_PORT=9410
CTM_DATA_DIR=/opt/mobile/server/data
CTM_LINK_TTL_SECONDS=600
CTM_SEND_TIMEOUT_MS=25000
CTM_LOG_LEVEL=info
